AZURE_STORAGE_CONTAINER=geocon-files
AZURE_STORAGE_KEY=
SHAREPOINT_TEMPLATES_URL=

# Accounting shared drive: DAS 140, DAS 142, setup sheet, regional folders (Documents page).
NEXT_PUBLIC_DAS_FORMS_FOLDER=S:\\Accounting Shared\\DAS 140 and DAS 142 Forms and Confirmations

GRAPH_APP_TENANT_ID=

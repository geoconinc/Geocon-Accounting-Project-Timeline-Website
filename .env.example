# =====================================================================
# Geocon Project Management — Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local.
# =====================================================================

# --- Auth (Microsoft Entra / MSAL) ---
NEXT_PUBLIC_MSAL_CLIENT_ID=
NEXT_PUBLIC_MSAL_TENANT_ID=
NEXT_PUBLIC_MSAL_REDIRECT_URI=http://localhost:3000
ALLOWED_EMAIL_DOMAIN=geoconinc.com

# --- Database ---
# postgres = Azure Flexible Server / Neon / Supabase. Run `npm run db:migrate` first.
STORAGE_DRIVER=postgres
DATABASE_URL=postgresql://accountingrojecttimelinewebsiteadmin:Admin123@accounting-project-timeline-website.postgres.database.azure.com:5432/postgres?sslmode=require


# --- File attachments ---
# Files are stored directly in PostgreSQL (max 10 MB per file).
# No external storage configuration needed.

# --- Email notifications (SMTP recommended) ---
# smtp = use SMTP_* below. graph = Microsoft Graph Mail.Send (needs GRAPH_APP_*).
EMAIL_DRIVER=smtp
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM_ADDRESS=
NOTIFY_FROM_NAME=Geocon Project Management

# --- Microsoft Graph (optional: only needed if EMAIL_DRIVER=graph) ---
GRAPH_APP_TENANT_ID=
GRAPH_APP_CLIENT_ID=
GRAPH_APP_CLIENT_SECRET=

# --- App ---
APP_BASE_URL=http://localhost:3000
BOARD_ADMIN_EMAILS=
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=mundra@geoconinc.com
# --- Cron (daily incomplete-week reminder) ---
# Random string shared between the web service and your scheduler (Render Cron Job, etc.).
CRON_SHARED_SECRET=

# --- Documents page (local network path for DAS forms) ---
NEXT_PUBLIC_DAS_FORMS_FOLDER=S:\\Accounting Shared\\DAS 140 and DAS 142 Forms and Confirmations



# =====================================================================
# Geocon Project Management — Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local.
# =====================================================================

# --- Auth (Microsoft Entra / MSAL) ---
NEXT_PUBLIC_MSAL_CLIENT_ID=
NEXT_PUBLIC_MSAL_TENANT_ID=
NEXT_PUBLIC_MSAL_REDIRECT_URI=http://localhost:3000
ALLOWED_EMAIL_DOMAIN=geoconinc.com

# --- Database ---
# postgres = Azure Flexible Server / Neon / Supabase. Run `npm run db:migrate` first.
STORAGE_DRIVER=postgres
DATABASE_URL=

# --- File attachments ---
# sharepoint = Graph upload to a SharePoint library folder.
# blob = Azure Blob SAS upload (requires AZURE_STORAGE_* below).
FILE_STORAGE_DRIVER=sharepoint
SHAREPOINT_HOSTNAME=
SHAREPOINT_SITE_PATH=
SHAREPOINT_LIBRARY_NAME=Documents
SHAREPOINT_FOLDER_ROOT=Geocon Project Timeline

# Only needed if FILE_STORAGE_DRIVER=blob
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=geocon-files
AZURE_STORAGE_KEY=

# --- Microsoft Graph (email + SharePoint file uploads) ---
GRAPH_APP_TENANT_ID=
GRAPH_APP_CLIENT_ID=
GRAPH_APP_CLIENT_SECRET=
NOTIFY_FROM_ADDRESS=

# --- App ---
APP_BASE_URL=http://localhost:3000
BOARD_ADMIN_EMAILS=
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=mundra@geoconinc.com
CRON_SHARED_SECRET=

# --- Documents page (local network path for DAS forms) ---
NEXT_PUBLIC_DAS_FORMS_FOLDER=S:\\Accounting Shared\\DAS 140 and DAS 142 Forms and Confirmations

{
  "name": "geocon-project-timeline",
  "version": "2.4.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "postcss": "^8.5.10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "cross-env NEXT_PUBLIC_MSAL_CLIENT_ID=11111111-1111-1111-1111-111111111111 NEXT_PUBLIC_MSAL_TENANT_ID=common NEXT_PUBLIC_SUPER_ADMIN_EMAIL=e2e@geoconinc.com next build",
    "start:e2e": "cross-env STORAGE_DRIVER=json next start -p 3100",
    "test:e2e": "playwright test",
    "test:e2e:build": "npm run build:e2e && playwright test",
    "prepare": "node scripts/setup-git-hooks.js",
    "version:bump": "tsx scripts/bump-version-cli.ts",
    "seed": "tsx scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local ./node_modules/.bin/tsx scripts/migrate.ts",
    "db:seed-roster": "node --env-file=.env.local ./node_modules/.bin/tsx scripts/seed-site-config.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.20.0",
    "@azure/msal-react": "^2.0.22",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.441.0",
    "next": "14.2.35",
    "nodemailer": "^8.0.10",
    "pg": "^8.13.0",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.16.5",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.10",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  }
}
